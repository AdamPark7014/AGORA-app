{
  "name": "@agora/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Fuente única de los colores de Ágora (B «Cholula») para web, Android e iOS.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "pnpm build && node --test dist/tokens.test.js",
    "generar": "pnpm build && node dist/cli.js generar",
    "revisar": "pnpm build && node dist/cli.js revisar"
  },
  "devDependencies": {
    "@agora/config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
