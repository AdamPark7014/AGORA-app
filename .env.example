# ---------------------------------------------------------------------------
# Agora — plantilla de entorno. SOLO NOMBRES DE VARIABLES, nunca valores.
# Copiar a .env y llenar. .env esta en .gitignore y no debe subirse jamas.
# ---------------------------------------------------------------------------

# Base de datos
DATABASE_URL=
DIRECT_DATABASE_URL=

# Redis / BullMQ
REDIS_URL=

# Sesiones
SESSION_SECRET=

# Entorno: development | production
NODE_ENV=

# ---------------------------------------------------------------------------
# Correo OTP
# ---------------------------------------------------------------------------
# MAIL_PROVIDER admite tres valores:
#
#   console  -> el codigo sale en el log de la API. SOLO desarrollo; el
#               arranque falla si se deja puesto con NODE_ENV=production.
#   brevo    -> correo real por Brevo.  Exige BREVO_API_KEY.
#   resend   -> correo real por Resend. Exige RESEND_API_KEY.
#
# Cambiar de proveedor es cambiar esta linea; el resto del .env no se toca.
MAIL_PROVIDER=console

# Llave del proveedor que hayas elegido. Solo hace falta la de ese.
#   Brevo:  panel -> SMTP & API -> API Keys.  Empieza con "xkeysib-".
#           Es la MISMA cuenta que ya usas en demo.erperiencebt.com.mx; puedes
#           reutilizar esa llave o generar una nueva solo para Agora, que es
#           lo recomendable para poder revocarla sin tumbar el otro proyecto.
#   Resend: panel -> API Keys.  Empieza con "re_".
BREVO_API_KEY=
RESEND_API_KEY=

# Seguimiento de entrega (opcional). Brevo avisa por webhook si el codigo se
# entrego o reboto, y la pantalla de "Revisa tu correo" lo muestra. El webhook
# se registra en Brevo apuntando a <API>/api/correo/brevo/<este token>. Vacio:
# la ruta no existe y el estado se consulta a la API de eventos de Brevo.
CORREO_WEBHOOK_TOKEN=

# Remitente. Formato "Nombre <buzon@dominio.mx>" o "buzon@dominio.mx".
# OJO: si lleva < > o espacios, ENTRECOMILLALO. Sin comillas, cargar el .env
# desde bash interpreta el < como redireccion y la carga aborta a media lista.
# El dominio debe estar verificado en el proveedor (registros DKIM/SPF), o el
# envio falla con 422. NO uses @udlap.mx: ese dominio no es tuyo.
MAIL_FROM=

# Almacenamiento de imagenes (S3 compatible / Cloudflare R2)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Moderacion. En produccion es obligatoria salvo que se declare lo contrario
# a proposito con MODERACION_OPCIONAL=true.
OPENAI_API_KEY=
MODERACION_OPCIONAL=

# Poner en true cuando la API corre detras de un proxy (Traefik/Caddy/Coolify).
# Sin esto, el limite por IP ve siempre la IP del proxy y castiga a todos.
TRUST_PROXY=

# Proveedor institucional — apagado por defecto (ver plan 1.4)
ENTRA_ID_ENABLED=
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_TENANT_ID=

# URLs publicas
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_URL=
# El panel de moderacion vive en su propio subdominio: admin.tudominio.mx
NEXT_PUBLIC_ADMIN_URL=

# Dominio de la cookie de sesion. En produccion ponlo con punto inicial
# (".tudominio.mx") para que la sesion sirva en la web Y en el panel.
# En desarrollo dejalo VACIO: un dominio con "localhost" hace que el navegador
# descarte la cookie y nadie puede entrar.
COOKIE_DOMAIN=

# Web Push (opcional). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@udlagora.com

# FCM (Android). JSON del service account de Firebase Console
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa: ruta a archivo JSON del service account
GOOGLE_APPLICATION_CREDENTIALS=

# APNs (iOS). Clave .p8 de Apple Developer → Keys
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_SIGNING_KEY=
APNS_BUNDLE_ID=mx.agora.mobile.AgoraApp
# true en producción / TestFlight; omitir o false = sandbox
APNS_PRODUCTION=
