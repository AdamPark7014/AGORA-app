{
  "name": "agora-platform",
  "version": "0.1.0",
  "description": "Red social verificada para la comunidad UDLAP. Identidad real, comunidades derivadas del grafo academico.",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.30.3"
  },
  "scripts": {
    "predev": "pnpm db:generate && pnpm --filter \"@agora/shared\" --filter \"@agora/contracts\" build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@agora/web",
    "dev:api": "turbo run dev --filter=@agora/api",
    "dev:admin": "pnpm --filter @agora/admin dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "eslint .",
    "format": "pnpm --recursive exec prettier --write .",
    "format:check": "pnpm --recursive exec prettier --check .",
    "db:generate": "pnpm --filter @agora/db prisma:generate",
    "postinstall": "pnpm db:generate",
    "db:migrate": "pnpm --filter @agora/db prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @agora/db prisma:migrate:deploy",
    "db:seed": "pnpm --filter @agora/db prisma:seed",
    "db:studio": "pnpm --filter @agora/db prisma:studio",
    "db:reset": "pnpm --filter @agora/db prisma:reset",
    "test": "turbo run test",
    "test:e2e": "playwright test -c playwright.config.ts",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --wait postgres redis",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:reset": "docker compose -f infra/docker-compose.yml down --volumes --remove-orphans",
    "secrets:scan": "gitleaks detect --no-git --redact -v",
    "ci:verify": "pnpm lint && turbo run check-types test build",
    "e2e": "playwright test",
    "correo:probar": "tsx --env-file=.env scripts/probar-correo.ts",
    "db:limpiar-pruebas": "tsx --env-file=.env scripts/limpiar-pruebas.ts",
    "db:demo": "tsx --env-file=.env scripts/sembrar-demo.ts",
    "rol": "tsx --env-file=.env scripts/dar-rol.ts",
    "mobile:android:preview": "pwsh -ExecutionPolicy Bypass -File scripts/preview-android-emulator.ps1",
    "mobile:android:verify": "pwsh -ExecutionPolicy Bypass -File scripts/verify-mobile-native.ps1",
    "db:limpiar-caducados": "tsx --env-file=.env scripts/limpiar-caducados.ts",
    "lint:fix": "eslint . --fix",
    "ci:verify:sin-turbo": "pnpm lint && pnpm -r run check-types && pnpm -r run test && pnpm -r run build"
  },
  "devDependencies": {
    "@agora/correo": "workspace:*",
    "@agora/db": "workspace:*",
    "@agora/rbac": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  }
}
