{
  "expo": {
    "name": "Ágora",
    "slug": "agora-udlap",
    "scheme": "agora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.agora.udlap"
    },
    "android": {
      "package": "mx.agora.udlap",
      "adaptiveIcon": {
        "backgroundColor": "#e35205"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": null
    }
  }
}
